# Replace these values before deploying outside local development.
MYSQL_DATABASE=gymdb
MYSQL_USER=gymflow
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3306

# Generate with: openssl rand -base64 32
GYM_JWT_SECRET=replace-with-a-base64-encoded-random-secret-of-at-least-32-bytes
GYM_BUSINESS_ZONE=Asia/Kolkata
GYM_CORS_ORIGIN=http://localhost:4200
# For AWS deployment, set this to http://<EC2_PUBLIC_IP> or https://yourdomain.com
GYM_APP_URL=http://localhost:4200
# Set to false for HTTP deployments (so browser keeps JWT cookies). Set to true only with HTTPS.
GYM_COOKIE_SECURE=false

# Super-Admin Platform Credentials
GYM_PLATFORM_ADMIN_EMAIL=admin@gymflow.io
# Set a custom password for production (the default AdminPassword123! is blocked in non-dev environments)
GYM_PLATFORM_ADMIN_PASSWORD=change-this-super-admin-password
# GYM_PLATFORM_ALLOW_DEFAULT_ADMIN_PASSWORD=true

GYM_RENEWAL_REMINDERS_CRON=0 */15 * * * *
# Estimated inclusive-GST analytics defaults; configure rates and supply type for your tax setup.
GYM_TAX_CGST_RATE=9.00
GYM_TAX_SGST_RATE=9.00
GYM_TAX_IGST_RATE=18.00
GYM_TAX_INTERSTATE=false
# Local: 127.0.0.1 / 4200. On AWS EC2: WEB_BIND_ADDRESS=0.0.0.0, WEB_PORT=80
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80

# Set these to an SMTP provider to enable password reset and notifications.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
